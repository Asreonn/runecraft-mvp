  "note": "Durations, counts, radii are never scaled. Event coefficient (per carrier) multiplies only instant Damage of grafted contributions. Grafted propagators also carry the host payload with depth-scaled power/frac (a chain grafted at depth 1 carries ×0.7 of its own falloff)."
 },
 "budgets": {
  "applications_per_root_event": 16,
  "max_generation": 2,
  "chain_range_tiles": 1.5,
  "fields_per_tower": 8,
  "extra_beetles_from_brood": 2,
  "note": "Hidden from the player (v4 §19). A propagated event carries generation+1; propagators stop at max_generation.",
  "field_stacking": "Overlapping fields of the same kind from the same tower do not stack: an enemy is hit by at most one of them per field tick.",
  "status_spread_once": "A status instance (burn/poison) propagates only on its first tick; later ticks still deal damage and pay graft payload but do not chain again (v4 §19 'status tick -> new status tick')."
 },
